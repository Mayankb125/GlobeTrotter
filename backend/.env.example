# Backend Configuration Template

# App Environment (development, staging, production)
APP_ENV=development

# Logging level
LOG_LEVEL=INFO

# Database Connection (Async PG driver is required)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/globetrotter

# Authentication Secret Key (Generate a random string)
SECRET_KEY=placeholder-secret-key-change-in-production

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Third-party AI API Keys (Optional at startup, app degrades gracefully if missing)
GROQ_API_KEY=placeholder-groq-api-key
GEMINI_API_KEY=placeholder-gemini-api-key

# File Upload Directory
UPLOAD_DIR=./uploads

# CORS settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173

# Frontend public base URL for share links
FRONTEND_URL=http://localhost:5173
